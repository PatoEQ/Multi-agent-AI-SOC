# =============================================================================
# SOC Sentinel Crew — environment template
# -----------------------------------------------------------------------------
# 1. Copy this file:   cp .env.example .env     (Windows: copy .env.example .env)
# 2. Put your real keys in ".env" — it is git-ignored and must NEVER be committed.
# 3. This .env.example is safe to commit: it contains placeholders only.
# Blank values are treated as "not set" (tools then use mock data).
# =============================================================================

# -------- LLM (pick ONE provider) --------------------------------------------
#   OpenAI     : gpt-4o-mini | gpt-4o
#   Anthropic  : anthropic/claude-sonnet-4-5
#   Local      : ollama/llama3.1   (+ LLM_BASE_URL=http://localhost:11434)
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_BASE_URL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -------- Threat-intel tools (optional — mock fallback when blank) -----------
VIRUSTOTAL_API_KEY=
# Free tier = 4 requests/minute -> keep 15 s. Lower it only with a paid key.
VT_MIN_INTERVAL_SECONDS=15
# EXA search (https://exa.ai). Blank = free DuckDuckGo search.
EXA_API_KEY=
CACHE_TTL_SECONDS=3600

# -------- SIEM backend --------------------------------------------------------
# chronicle_mock (default, simulated) | splunk | elastic | sentinel (beta)
SIEM_BACKEND=chronicle_mock
SIEM_LOOKBACK_HOURS=24
SIEM_MAX_EVENTS=50

# Splunk (REST API, usually port 8089) — token needs search permission only
SPLUNK_URL=
SPLUNK_TOKEN=
SPLUNK_INDEX=*
SPLUNK_VERIFY_TLS=1

# Elasticsearch / Elastic Security — read-only API key
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX=logs-*

# Microsoft Sentinel (Log Analytics) — app registration with "Log Analytics Reader"
SENTINEL_WORKSPACE_ID=
SENTINEL_TENANT_ID=
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# -------- Safety & privacy ---------------------------------------------------
# Replace usernames, hostnames and internal IPs with pseudonyms before anything
# is sent to the LLM provider (restored locally in the report). Recommended for
# real data.
REDACT_PII=0
# Alerts longer than this are truncated before reaching the agents.
MAX_ALERT_CHARS=20000
# Stop after triage on a clear FALSE_POSITIVE (never when injection is detected).
TRIAGE_EARLY_EXIT=1

# -------- Behaviour ----------------------------------------------------------
# FORCE_MOCK=1: every external tool returns canned data (no network, no keys).
FORCE_MOCK=0
# Investigation phase: "sequential" (deterministic, recommended) or "hierarchical"
CREW_PROCESS=sequential
CREW_VERBOSE=1
HTTP_TIMEOUT=20

# CrewAI anonymous telemetry is disabled by default by this project.
# Set CREWAI_DISABLE_TELEMETRY=false if you want to opt back in.
